# Public site address used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://academia-ib.vercel.app

# Supabase project (Settings → API). The publishable/anon key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 32 random bytes, base64. Encrypts ManageBac calendar links at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
